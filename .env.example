APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mobile_store
DB_USER=mobile_store_app
DB_PASSWORD=

# Optional DDL-capable account used only by database/migrate.php
DB_MIGRATION_USER=mobile_store_migrator
DB_MIGRATION_PASSWORD=
DB_CHARSET=utf8mb4
